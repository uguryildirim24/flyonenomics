  "qualification": "951 passed, 30 skipped, 49 warnings at cb9229a; same pinned code. Review round runs pinned gate.",
  "affine_warning": "Finite but ill-conditioned: tiny positive corrected predictor variances produce huge scales. No clamping, tolerance changes, alternative fit or omitted output. CI includes zero: no detected difference; does not rule out affine explanation.",
  "descriptive_intervals": "Seed ranges only, not additional confidence intervals or tests.",
  "descriptive_extraction_source": "\"\"\"Read-only frozen descriptive readouts and affine conditioning diagnostics.\nNo new tests, thresholds, fits, bootstrap, selection or changes to inference.\n\"\"\"\nfrom pathlib import Path\nimport json,sys\nimport numpy as np\nsys.path.insert(0,str(Path.cwd()/'scripts'))\nimport adhd_study as s\nfrom flyonenomics.io import load_npy\nraw=Path('camber-runs/adhd-study/5b-02')\nplan,pair=s.read(s.PLAN),s.read(s.PAIR)\nrates,hashes=s.load_rates(raw,'5b',plan_hash=s.sha(s.PLAN),pair_hash=s.sha(s.PAIR))\ncal,cal_hashes=s.load_rates(Path('camber-runs/adhd-study/5a-01'),'5a',plan_hash=plan['calibration_reference']['plan_sha256'])\nresult=s.read(Path('camber-runs/adhd-study/5b-02-results.json'))\nassert result['raw_sha256']==hashes and result['calibration_sha256']==cal_hashes\n_,axis=s.analysis.templates(cal,tuple(pair['pair']))\naffine=s.analysis.affine_residual(rates,axis)\nnp.testing.assert_array_equal(affine['residual'],result['affine_secondary']['residual'])\nfolds=[]\nfor held in range(10):\n    train=np.arange(10)!=held\n    x,y=rates[train,0,:3],rates[train,1,:3]\n    n=len(x);xc,yc=x-x.mean(axis=1,keepdims=True),y-y.mean(axis=1,keepdims=True)\n    xm,ym=xc.mean(axis=0),yc.mean(axis=0);dx,dy=xc-xm,yc-ym\n    variance=np.mean(xm*xm-np.sum(dx*dx,axis=0)/(n*(n-1)),axis=0)\n    covariance=np.mean(xm*ym-np.sum(dx*dy,axis=0)/(n*(n-1)),axis=0)\n    scale,offset,resolved=s.analysis.fit_affine(x,y)\n    folds.append({'held_seed':201+held,'corrected_variance_hz2':variance.tolist(),\n                  'corrected_covariance_hz2':covariance.tolist(),'scale':scale.tolist(),\n                  'offset_hz':offset.tolist(),'resolved':resolved.tolist(),\n                  'minimum_positive_variance_hz2':float(variance[variance>0].min()),\n                  'maximum_scale':float(scale.max()),'maximum_scale_cell_position':int(scale.argmax())})\nlabels=['ER','TuBu','DAN','CX_DAN','central']\nprimary,full,injected_primary,injected_full,terms,pool_occ,drifts=[],[],[],[],[],[],[]\nfor seed in range(201,211):\n    run=s.read(raw/f'seed-{seed}.json')\n    for row in run['rows']:\n        with load_npy(raw/row['file'],allow_pickle=False) as z:\n            counts=[z['er_counts'].sum(axis=1),z['tubu_counts'].sum(axis=1),\n                    z['DAN_counts'],z['CX_DAN_counts'],z['central_counts']]\n            primary.append([int(v[800:1000].sum()) for v in counts])\n            full.append([int(v[800:].sum()) for v in counts])\n            ticks=z['injected_ticks'];injected_primary.append(int(((ticks>=80000)&(ticks<100000)).sum()))\n            injected_full.append(int((ticks>=80000).sum()))\n            terms.append([float(z[k][800:1000].mean()) for k in ('er_dv_mv','er_gain','er_occ1','er_occ2')])\n            pool_occ.append([z[k][800:1000].mean(axis=0).tolist() for k in ('pool_occ_D1','pool_occ_D2')])\n            drifts.append((z['pool_um'][200]-z['pool_um'][0]).tolist())\n            for key in z.files: assert np.all(np.isfinite(z[key])),(row['file'],key)\n    print(f'described seed {seed}',file=sys.stderr,flush=True)\nn=[245,156,*[run['rows'][0]['group_n'][k] for k in labels[2:]]]\nprimary=np.array(primary).reshape(10,4,8,5);full=np.array(full).reshape(10,4,8,5)\nterms=np.array(terms).reshape(10,4,8,4);drifts=np.array(drifts).reshape(10,4,8,-1)\nj=np.array(result['mixture']['J_hz'])@axis\nh=np.array(result['H_per_seed_condition'])\ndef summary(x):\n    return {'mean':x.mean(axis=0).tolist(),'seed_min':x.min(axis=0).tolist(),'seed_max':x.max(axis=0).tolist(),\n            'range_is_not_confidence_interval':True}\nrecord={'purpose':'Frozen descriptive secondaries and unchanged affine fit conditioning; no new inferential tests',\n        'conditions':list(s.analysis.CONDITIONS),'protocols':list(s.analysis.PROTOCOLS),\n        'plan_sha256':s.sha(s.PLAN),'pair_sha256':s.sha(s.PAIR),'result_sha256':s.sha(Path('camber-runs/adhd-study/5b-02-results.json')),\n        'population_labels':labels,'population_neuron_counts':n,\n        'primary_window_s':[8,10],'full_test_window_s':[8,22],\n        'primary_spikes_per_seed_condition_protocol_population':primary.tolist(),\n        'full_test_spikes_per_seed_condition_protocol_population':full.tolist(),\n        'primary_mean_per_neuron_hz':summary(primary/(2*np.array(n))),\n        'full_test_mean_per_neuron_hz':summary(full/(14*np.array(n))),\n        'primary_injected_events_per_seed_condition_protocol':np.array(injected_primary).reshape(10,4,8).tolist(),\n        'full_test_injected_events_per_seed_condition_protocol':np.array(injected_full).reshape(10,4,8).tolist(),\n        'H_primary':summary(h),'J_projected':summary(j),'J_projected_per_seed_condition':j.tolist(),\n        'mixture_coefficients':summary(np.array(result['mixture']['coefficients'])),\n        'mixture_residual_norm_hz':summary(np.array(result['mixture']['residual_norm_hz'])),\n        'receptor_term_labels':['threshold_shift_mv','gain','D1_occupancy','D2_occupancy'],\n        'primary_ER_receptor_terms':summary(terms),\n        'compartments':plan['compartments'],\n        'primary_pool_D1_D2_occupancy':np.array(pool_occ).reshape(10,4,8,2,-1).tolist(),\n        'settle_pool_drift_um':summary(drifts),\n        'affine_conditioning':{'folds':folds,'cell_metadata':plan['cells'],\n            'interpretation':'Near-zero positive corrected variances are not clamped by the frozen rule. Large fitted scales make this secondary unstable; original result retained without tolerance changes or refitting.'},\n        'all_raw_arrays_finite':True,'DAN_and_CX_DAN_per_cell_traces_available':False,\n        'readout_limit':'Only recorded DAN/CX_DAN/central group totals; per-neuron group means are totals divided by census size, not invented individual traces.'}\nprint(json.dumps(record,indent=2,allow_nan=False))\n",
